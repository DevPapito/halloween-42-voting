# Copie para .env.local (desenvolvimento) e cadastre os mesmos nomes na Vercel
# em Settings -> Environment Variables.

# --- Supabase PostgreSQL (Settings -> Database -> Transaction pooler) ---
# Inclua ?sslmode=require no final da URL.
DATABASE_URL=postgresql://postgres.projeto:senha@aws-0-regiao.pooler.supabase.com:6543/postgres?sslmode=require

# --- Supabase Storage (Settings -> API) ---
# Project URL e chave service_role/Secret key, usados apenas pelo servidor.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole-sua-chave-secreta-do-supabase

# --- Painel administrativo ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=defina-uma-senha-forte
# Segredo HMAC da sessão, com no mínimo 32 caracteres aleatórios.
SESSION_SECRET=gere-um-segredo-aleatorio-com-32-caracteres-ou-mais

# Usado somente no servidor local. Não é necessário como variável da Vercel.
PORT=3001
